# MK APPREALS — Environment Configuration Example
# Copy this file to .env.local and populate with your Supabase credentials.

# Public Supabase credentials (for client and server auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY. NEVER expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Application Configuration
NEXT_PUBLIC_APP_NAME="MK APPREALS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Note: If Supabase credentials are not provided or set to placeholders,
# MK APPREALS operates in self-contained deterministic persistence mode
# with realistic pre-seeded garment workers, operations, and 6+ months of history.
